---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import VerificationBadge from '../../components/VerificationBadge.astro';
import WarningBanner from '../../components/WarningBanner.astro';
import CodeCopy from '../../components/CodeCopy.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) => !data.draft);
  return projects.map((p) => ({ params: { slug: p.id }, props: { project: p } }));
}

const { project } = Astro.props;
const d = project.data;
const { Content } = await render(project);

const safetyStyle = {
  low: 'text-brand',
  medium: 'text-accent',
  high: 'text-red-400',
} as const;
---

<BaseLayout title={`${d.title} | Makora`} description={d.description}>
  <article data-pagefind-body class="mx-auto max-w-4xl px-4 py-12 sm:px-6">
    <a href="/projects" class="text-sm text-muted hover:text-brand">← All projects</a>

    <div class="mt-4 flex flex-wrap items-center gap-2 text-xs">
      <span class="rounded-full bg-brand/15 px-2.5 py-1 font-medium text-brand">{d.category}</span>
      <VerificationBadge status={d.verification} />
    </div>

    <h1 class="mt-4 text-4xl font-bold tracking-tight sm:text-5xl">{d.title}</h1>
    <p class="mt-3 text-lg text-muted">{d.description}</p>

    <dl class="mt-6 grid grid-cols-2 gap-4 rounded-card border border-border bg-surface p-5 sm:grid-cols-3">
      <div>
        <dt class="text-xs uppercase tracking-wider text-muted">Difficulty</dt>
        <dd class="mt-1 font-semibold">{d.difficulty}</dd>
      </div>
      <div>
        <dt class="text-xs uppercase tracking-wider text-muted">Time</dt>
        <dd class="mt-1 font-semibold">{d.time}</dd>
      </div>
      <div>
        <dt class="text-xs uppercase tracking-wider text-muted">Safety level</dt>
        <dd class={`mt-1 font-semibold capitalize ${safetyStyle[d.safetyLevel]}`}>{d.safetyLevel}</dd>
      </div>
    </dl>

    <div class="mt-6"><WarningBanner status={d.verification} /></div>

    <section class="mt-12">
      <h2 class="text-2xl font-bold">Safety notes</h2>
      <ul class="mt-4 list-disc space-y-2 pl-6 text-muted">
        {d.safetyNotes.map((n) => <li>{n}</li>)}
      </ul>
    </section>

    <section class="mt-12">
      <h2 class="text-2xl font-bold">Components</h2>
      <div class="mt-4 overflow-x-auto rounded-card border border-border">
        <table class="w-full text-left text-sm">
          <thead class="bg-surface-2 text-muted">
            <tr>
              <th class="px-4 py-3 font-medium">Component</th>
              <th class="px-4 py-3 font-medium">Qty</th>
              <th class="px-4 py-3 font-medium">Note</th>
            </tr>
          </thead>
          <tbody>
            {d.components.map((c) => (
              <tr class="border-t border-border">
                <td class="px-4 py-3">{c.name}</td>
                <td class="px-4 py-3">{c.quantity}</td>
                <td class="px-4 py-3 text-muted">{c.note ?? ''}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    {d.pinConnections.length > 0 && (
      <section class="mt-12">
        <h2 class="text-2xl font-bold">Pin connections</h2>
        <div class="mt-4 overflow-x-auto rounded-card border border-border">
          <table class="w-full text-left text-sm">
            <thead class="bg-surface-2 text-muted">
              <tr>
                <th class="px-4 py-3 font-medium">From</th>
                <th class="px-4 py-3 font-medium">To</th>
                <th class="px-4 py-3 font-medium">Note</th>
              </tr>
            </thead>
            <tbody>
              {d.pinConnections.map((p) => (
                <tr class="border-t border-border">
                  <td class="px-4 py-3 font-mono">{p.from}</td>
                  <td class="px-4 py-3 font-mono">{p.to}</td>
                  <td class="px-4 py-3 text-muted">{p.note ?? ''}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    )}

    <section class="mt-12">
      <h2 class="text-2xl font-bold">What you will learn</h2>
      <ul class="mt-4 list-disc space-y-2 pl-6 text-muted">
        {d.learningOutcomes.map((o) => <li>{o}</li>)}
      </ul>
    </section>

    <div class="prose-makora mt-12">
      <Content />
    </div>

    {d.videoId && (
      <section class="mt-12">
        <h2 class="text-2xl font-bold">Demo video</h2>
        <div class="mt-4 aspect-video overflow-hidden rounded-card border border-border">
          <iframe
            class="h-full w-full"
            src={`https://www.youtube-nocookie.com/embed/${d.videoId}`}
            title={`${d.title} video`}
            loading="lazy"
            allowfullscreen
          ></iframe>
        </div>
      </section>
    )}
  </article>
  <CodeCopy />
</BaseLayout>