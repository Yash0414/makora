---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import ProjectFilters from '../../components/ProjectFilters.astro';
import Search from '../../components/Search.astro';

const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishedDate.getTime() - a.data.publishedDate.getTime(),
);
const categories = [
  'Arduino', 'ESP32', 'IoT', 'Robotics', 'Drones', 'AI & Vision', '3D Printing', 'Sensors',
];
const difficulties = ['Beginner', 'Intermediate', 'Advanced'];
---

<BaseLayout
  title="Projects | Makora"
  description="Browse step-by-step robotics, electronics and IoT projects with components, wiring and code."
>
  <section class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
    <SectionHeading
      eyebrow="Projects"
      title="All projects"
      text="Every project lists its parts, wiring, code and safety notes."
    />
    <Search />
    <ProjectFilters categories={categories} difficulties={difficulties} />
    <div id="project-grid" class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {projects.map((p) => (
        <div data-category={p.data.category} data-difficulty={p.data.difficulty}>
          <ProjectCard
            title={p.data.title}
            category={p.data.category}
            difficulty={p.data.difficulty}
            time={p.data.time}
            href={`/projects/${p.id}`}
            demo={p.data.verification === 'demo'}
          />
        </div>
      ))}
    </div>

    {projects.length === 0 && <p class="mt-10 text-muted">No projects yet. Check back soon.</p>}
  </section>
</BaseLayout>