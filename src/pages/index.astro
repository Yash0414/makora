---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCollection } from 'astro:content';

const categories = [
  { name: 'Arduino', desc: 'Start with the basics of microcontrollers.' },
  { name: 'ESP32', desc: 'Wi-Fi and Bluetooth enabled builds.' },
  { name: 'IoT', desc: 'Connect devices to the internet.' },
  { name: 'Robotics', desc: 'Motors, sensors and movement.' },
  { name: 'Drones', desc: 'Flight controllers and aerial builds.' },
  { name: 'AI & Vision', desc: 'Computer vision and smart projects.' },
  { name: '3D Printing', desc: 'Design and print your own parts.' },
  { name: 'Sensors', desc: 'Read the world with electronics.' },
];

const steps = [
  { n: '01', title: 'Pick a project', text: 'Browse by category and difficulty level.' },
  { n: '02', title: 'Gather components', text: 'Every project lists parts with quantities.' },
  { n: '03', title: 'Build step by step', text: 'Follow circuits, code and assembly images.' },
];
const featured = (await getCollection('projects', ({ data }) => data.featured && !data.draft))
  .sort((a, b) => b.data.publishedDate.getTime() - a.data.publishedDate.getTime())
  .slice(0, 3);


---

<BaseLayout>
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div
      class="pointer-events-none absolute inset-0 -z-10 opacity-60"
      style="background: radial-gradient(60% 50% at 50% 0%, color-mix(in srgb, var(--brand) 22%, transparent), transparent 70%);"
    >
    </div>
    <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 sm:py-28">
      <p class="inline-block rounded-full border border-border bg-surface px-3 py-1 text-xs text-muted">
        100% free for students and makers
      </p>
      <h1 class="mt-6 max-w-3xl text-4xl font-bold leading-tight tracking-tight sm:text-6xl">
        Build real <span class="text-brand">robotics & electronics</span> projects, step by step.
      </h1>
      <p class="mt-5 max-w-2xl text-lg text-muted">
        Circuit diagrams, pin connections, source code and assembly guides, all documented in one place.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/projects" class="rounded-lg bg-brand px-6 py-3 font-semibold text-bg transition hover:bg-brand-strong">
          Explore projects
        </a>
        <a href="/tutorials" class="rounded-lg border border-border px-6 py-3 font-semibold transition hover:border-brand hover:text-brand">
          Start learning
        </a>
      </div>
    </div>
  </section>

  <!-- Categories -->
  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <SectionHeading eyebrow="Categories" title="What do you want to build?" text="Choose a topic and dive in." />
    <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {categories.map((c) => (
        <a
          href={`/projects?category=${encodeURIComponent(c.name)}`}
          class="rounded-card border border-border bg-surface p-5 transition hover:-translate-y-1 hover:border-brand/60"
        >
          <h3 class="font-semibold">{c.name}</h3>
          <p class="mt-1 text-sm text-muted">{c.desc}</p>
        </a>
      ))}
    </div>
  </section>

  <!-- Featured projects (DEMO) -->
  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <SectionHeading
      eyebrow="Featured"
      title="Latest projects"
      text="Demo placeholders for now. Real, documented projects will replace these."
    />
    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {featured.map((p) => (
        <ProjectCard
          title={p.data.title}
          category={p.data.category}
          difficulty={p.data.difficulty}
          time={p.data.time}
          href={`/projects/${p.id}`}
          demo={p.data.verification === 'demo'}
        />
      ))}
    </div>
  </section>

  <!-- How it works -->
  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <SectionHeading eyebrow="How it works" title="From idea to working build" />
    <div class="mt-10 grid gap-6 md:grid-cols-3">
      {steps.map((s) => (
        <div class="rounded-card border border-border bg-surface p-6">
          <span class="font-mono text-sm text-brand">{s.n}</span>
          <h3 class="mt-3 text-lg font-semibold">{s.title}</h3>
          <p class="mt-2 text-sm text-muted">{s.text}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Closing banner -->
  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <div class="rounded-card border border-border bg-surface-2 p-8 text-center sm:p-12">
      <h2 class="text-2xl font-bold sm:text-3xl">Learn by building. Always free.</h2>
      <p class="mx-auto mt-3 max-w-xl text-muted">
        Safety notes are included in every project. Please read them before you start.
      </p>
      <a href="/projects" class="mt-6 inline-block rounded-lg bg-brand px-6 py-3 font-semibold text-bg transition hover:bg-brand-strong">
        Browse all projects
      </a>
    </div>
  </section>
</BaseLayout>