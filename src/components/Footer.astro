---
const year = new Date().getFullYear();
const cols = [
  {
    title: 'Learn',
    links: [
      { href: '/projects', label: 'Projects' },
      { href: '/tutorials', label: 'Tutorials' },
      { href: '/resources', label: 'Resources' },
    ],
  },
  {
    title: 'Community',
    links: [
      { href: '/community', label: 'Student Builds' },
      { href: '/contact', label: 'Contact' },
    ],
  },
  {
    title: 'About',
    links: [
      { href: '/about', label: 'About Makora' },
      { href: '/disclaimer', label: 'Safety & Disclaimer' },
    ],
  },
];
---

<footer class="mt-24 border-t border-border bg-surface">
  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-12 sm:px-6 md:grid-cols-4">
    <div>
      <a href="/" class="flex items-center gap-2 text-lg font-bold">
        <span class="grid h-8 w-8 place-items-center rounded-lg bg-brand text-bg">M</span>
        Makora
      </a>
      <p class="mt-3 max-w-xs text-sm text-muted">
        Free, hands-on engineering projects for students and makers worldwide.
      </p>
    </div>
    {cols.map((c) => (
      <div>
        <h2 class="text-sm font-semibold">{c.title}</h2>
        <ul class="mt-3 space-y-2">
          {c.links.map((l) => (
            <li>
              <a href={l.href} class="text-sm text-muted hover:text-brand">{l.label}</a>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
  <div class="border-t border-border">
    <p class="mx-auto max-w-6xl px-4 py-5 text-xs text-muted sm:px-6">
      © {year} Makora. Always follow safety guidelines when building electronics projects.
    </p>
  </div>
</footer>