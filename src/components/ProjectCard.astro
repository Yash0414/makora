---
interface Props {
  title: string;
  category: string;
  difficulty: 'Beginner' | 'Intermediate' | 'Advanced';
  time: string;
  href?: string;
  demo?: boolean;
}
const { title, category, difficulty, time, href = '#', demo = false } = Astro.props;
---

<a
  href={href}
  class="group flex flex-col overflow-hidden rounded-card border border-border bg-surface transition duration-300 hover:-translate-y-1 hover:border-brand/60 hover:shadow-glow"
>
  <div class="grid h-40 place-items-center bg-surface-2 text-sm text-muted">
    Image placeholder
  </div>
  <div class="flex flex-1 flex-col p-5">
    <div class="flex items-center gap-2 text-xs">
      <span class="rounded-full bg-brand/15 px-2.5 py-1 font-medium text-brand">{category}</span>
      {demo && <span class="rounded-full bg-accent/15 px-2.5 py-1 font-medium text-accent">Demo</span>}
    </div>
    <h3 class="mt-3 text-lg font-semibold group-hover:text-brand">{title}</h3>
    <p class="mt-auto pt-4 text-sm text-muted">{difficulty} · {time}</p>
  </div>
</a>