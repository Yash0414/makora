---
interface Props {
  eyebrow?: string;
  title: string;
  text?: string;
}
const { eyebrow, title, text } = Astro.props;
---

<div class="max-w-2xl">
  {eyebrow && <p class="text-sm font-semibold uppercase tracking-widest text-brand">{eyebrow}</p>}
  <h2 class="mt-2 text-3xl font-bold tracking-tight sm:text-4xl">{title}</h2>
  {text && <p class="mt-3 text-muted">{text}</p>}
</div>